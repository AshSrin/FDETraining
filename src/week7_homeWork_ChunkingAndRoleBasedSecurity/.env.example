# Copy to .env and fill in local values. Never commit .env.
# Admin/owner connection: used ONLY by bootstrap.py, ingest.py and the revocation test.
POSTGRES_SERVER_URL=postgresql://<admin_user>:<admin_password>@127.0.0.1:5432/postgres
DATABASE_NAME=k8s_raglab
# Restricted login used by search/retrieval. Subject to Row-Level Security.
READER_ROLE=k8s_rag_reader
READER_PASSWORD=<choose_a_local_password>
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Organisation (tenant) that owns the documents and users.
TENANT_ID=TECHORG_ENGINEERING
# Chunks farther than this cosine distance are treated as "not relevant" and never returned.
MAX_COSINE_DISTANCE=0.23
